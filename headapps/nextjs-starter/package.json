    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "scripts": {
    "bootstrap": "cross-env NODE_ENV=production npm-run-all --serial sitecore-tools:generate-map bootstrap:run",
    "bootstrap:run": "ts-node --require dotenv-flow/config --project tsconfig.scripts.json scripts/bootstrap.ts",
    "build-storybook": "storybook build",
    "build": "cross-env NODE_ENV=production npm-run-all --serial bootstrap sitecore-tools:build next:build",
    "chromatic": "npx chromatic --project-token=chpt_f457a31cb75e79b",
    "install-pre-commit-hook": "ts-node --project tsconfig.scripts.json ./scripts/install-pre-commit-hook.ts",
    "leprechaun": "dotnet leprechaun -g -c ../../leprechaun-typescript.config",
    "lint": "eslint ./src/**/*.tsx ./src/**/*.ts",
    "lint:js": "eslint ./src/**/*.tsx ./src/**/*.ts",
    "lint:prettier": "npx prettier **/*.{js,json,ts,tsx} --check",
    "next:build": "next build",
    "next:dev": "cross-env NODE_OPTIONS='--inspect' next dev",
    "next:start": "next start",
    "prebuild-storybook": "npm run bootstrap",
    "precommit": "npm run bootstrap && lint-staged && npm run lint:prettier && npm run lint:js && npx tsc --project tsconfig.json && npm run test",
    "prepush": "echo 'No prepush for now'",
    "prestorybook": "npm run bootstrap",
    "dev": "cross-env NODE_ENV=development npm-run-all --serial bootstrap sitecore-tools:build --parallel next:dev sitecore-tools:generate-map:watch",
    "start": "cross-env-shell NODE_ENV=production npm-run-all --serial bootstrap leprechaun sitecore-tools:build next:build next:start",
    "storybook": "storybook dev -p 6006",
    "update-snapshots": "npm run bootstrap && jest -u",
    "test": "jest",
    "sitecore-tools:generate-map": "sitecore-tools project component generate-map",
    "sitecore-tools:generate-map:watch": "sitecore-tools project component generate-map --watch",
    "sitecore-tools:build": "sitecore-tools project build"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  },
  "homepage": "https://github.com/sitecore/jss#readme"
}
